# Oz Backend — Environment Variables
# Copy to .env (local dev) or set in MonsterASP control panel (production).
# NEVER commit .env. .env.example is the canonical reference.

# --- Required in all environments ---

# ASP.NET Core environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# SQL Server connection (use MonsterASP connection string in production)
ConnectionStrings__Default=Server=(localdb)\MSSQLLocalDB;Database=OzDev;Trusted_Connection=True;TrustServerCertificate=true;

# JWT signing key. Min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# --- Required in production (BE-100) ---

# Bosta shipping API key. Get from Bosta dashboard.
# BostaClient accepts both: BOSTA_API_KEY (preferred) and Bosta__ApiKey
BOSTA_API_KEY=

# Bosta webhook HMAC shared secret. Must match what Bosta sends in X-Bosta-Signature.
BOSTA_WEBHOOK_SECRET=

# --- Optional ---

# CORS allowed origin (your Vercel frontend)
VERCEL_ORIGIN=http://localhost:3000

# SMTP for transactional email. If missing, emails log but do not send.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-smtp-user
EMAIL_PASSWORD=your-smtp-app-password
EMAIL_FROM=noreply@ozuniforms.com

# --- Notes ---
# .NET env var convention: Section__Key maps to Section:Key in config.
# So ConnectionStrings__Default maps to ConnectionStrings:Default.
# ASP.NET Core reads env vars automatically — no code changes needed to swap source.
