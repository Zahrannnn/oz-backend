@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultTextAlignment center
skinparam actor {
  BorderColor #2980B9
  BackgroundColor #3498DB
  FontColor #FFFFFF
  FontSize 14
  FontStyle bold
}
skinparam participant {
  BorderColor #2C3E50
  BackgroundColor #ECF0F1
  FontColor #2C3E50
  FontSize 12
}
skinparam database {
  BorderColor #8E44AD
  BackgroundColor #E8DAEF
  FontColor #8E44AD
  FontSize 12
}

title "sd-12 — Admin Password Recovery (One-Time Code)"

actor "Administrator" as Admin
participant "Next.js Frontend\n(Vercel)" as FE
participant ".NET API\n(MonsterASP)" as API
database "MS SQL\nServer" as DB

== Admin Requests Reset ==

Admin -> FE: Click "Forgot Password"
activate FE
FE --> Admin: Enter email form
Admin -> FE: Submit email
FE -> API: POST /v1/auth/forgot-password\n{ email }
activate API

API -> DB: SELECT id, email, password_hash\nFROM admin WHERE email = ?
activate DB
DB --> API: { id, email }
deactivate DB

alt email not found
  API --> FE: 200 OK
  note right: Always return 200\n(no email enumeration)

else
  API -> API: Generate one_time_code\n(6-digit, crypto-random)

  API -> DB: INSERT password_recovery\n(admin_id, code_hash,\nexpires_at = NOW + 5 min,\nused = false)

  API -> DB: INSERT audit_log\n(action='admin.password_recovery',\nadmin_id=id)

  API --> FE: 200 OK\n{ message: 'If email exists,\ncode sent' }
end

deactivate API

FE --> Admin: "Check the app for\nthe recovery code"
deactivate FE

note right: Per interview decision:\n- No email reset link\n- One-time code displayed in-app\n- Admin registers using email from\nowner, enters code on login page
deactivate Admin

== Admin Enters Code ==

Admin -> FE: Enter 6-digit code
activate FE
FE -> API: POST /v1/auth/verify-recovery-code\n{ email, code }
activate API

API -> DB: SELECT id, code_hash,\nexpires_at, used\nFROM password_recovery\nWHERE admin_id IN\n(SELECT id FROM admin WHERE email = ?)\nAND used = false\nORDER BY created_at DESC\nOFFSET 0 ROWS FETCH NEXT 1 ROW ONLY
activate DB
DB --> API: { code_hash, expires_at, used }
deactivate DB

alt code_expired (NOW > expires_at)
  API --> FE: 410 Gone\n{ error: 'Code expired.\nRequest a new one.' }
else code_mismatch (hash != SHA256(code))
  API -> DB: UPDATE password_recovery\nSET attempts = attempts + 1
  activate DB
  deactivate DB
  API --> FE: 401 Unauthorized\n{ error: 'Invalid code' }
else
  API -> DB: UPDATE password_recovery\nSET used = true\nWHERE admin_id = adminId

  API -> API: Generate JWT (same as login,\nsub=adminId, 8h expiry)

  API -> DB: INSERT audit_log\n(action='admin.password_recovery_success')

  API --> FE: 200 OK\nSet-Cookie: jwt=<token>;\nHttpOnly; Secure; SameSite=Strict;\nPath=/admin; Max-Age=28800
end

deactivate API

FE -> FE: Redirect to dashboard
FE --> Admin: Dashboard
deactivate FE

@enduml
